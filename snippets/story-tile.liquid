{%- doc -%}
  Renders a story tile: the block's image with a play button that opens its video in a lightbox.

  @param {object} block - Story "images" block with `image` and optional `video` settings
  @param {string} [class] - Classes for the tile wrapper

  @example
  {% render 'story-tile', block: block, class: 'col-md-4' %}
{%- enddoc -%}

<div class="{{ class }} story__image-col">
  {%- assign image = block.settings.image -%}
  {{ image | image_url: width: 600 | image_tag: class: 'img-fluid', loading: 'lazy' }}

  {%- if block.settings.video -%}
    <a href="javacript:void(0)" onclick="playVideo('{{ block.settings.video.sources[0].url }}')"  class="story__video-link">
        <svg width="77" height="77" viewBox="0 0 77 77" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
          <rect width="77" height="77" fill="url(#pattern0_2846_1538)"/>
          <defs>
            <pattern id="pattern0_2846_1538" patternContentUnits="objectBoundingBox" width="1" height="1">
              <use xlink:href="#image0_2846_1538" transform="scale(0.00195312)"/>
            </pattern>
            <image id="image0_2846_1538" width="512" height="512" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
          </defs>
        </svg>
      </a>
  {%- endif -%}
</div>
