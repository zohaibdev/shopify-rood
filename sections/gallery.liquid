<div class="gallery__wrapper">
    <div class="section">
        <div class="row g-0">
            {%- for block in section.blocks -%}
                {%- assign image = block.settings.image -%}
                <div class="col-lg-3 col-sm-6 col-6">
                    <div class="gallery__item">
                        <a href="{{ section.settings.instagram_link }} " target="_blank" rel="noopener noreferrer">
                            {{ image | image_url: width: image.width | image_tag: class: 'gallery__image', loading: 'lazy' }}

                            <span>{{ section.settings.instagram_id }} </span>
                        </a>
                    </div>
                </div>
            {%- endfor -%}
        </div>
    </div>
</div>

{% schema %}
  {
  "name": "Gallery",
  "class": "gallery",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "instagram_id",
      "label": "Instagram ID",
      "default": "@jagmacdonald"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram Link"
    }
  ],
  "blocks": [
    {
      "name": "Image",
      "type": "image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery"
    }
  ]
}  
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}